# Circle API key for onramp session minting (server only).
CIRCLE_API_KEY=YOUR_API_KEY

# Bare hostname of the page that embeds the iframe (no scheme/port/path).
# Vite defaults to localhost — keep this in sync with where you open the app.
ONRAMP_REFERRER_DOMAIN=localhost

# --- sandbox (use for local development) ---
ONRAMP_API_BASE_URL=https://api-test.circle.com
ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
VITE_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io

# --- production (defaults — omit sandbox lines to use prod) ---
# ONRAMP_API_BASE_URL=https://api.circle.com
# ONRAMP_WIDGET_BASE_URL=https://onramp.arc.io
# VITE_ONRAMP_WIDGET_BASE_URL=https://onramp.arc.io
