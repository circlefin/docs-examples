{
  "name": "modular-wallets-mobile-expo-starter",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/wallet.test.ts",
    "check": "npm run typecheck && npm test && python3 check.py",
    "export:verify": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "1.0.13",
    "viem": "2.38.3",
    "webauthn-p256": "0.0.5",
    "expo": "~57.0.16",
    "expo-modules-core": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "expo-build-properties": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-local-authentication": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "@noble/curves": "1.9.7"
  },
  "main": "index.ts",
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.2.2",
    "@types/node": "^24.0.0"
  }
}
